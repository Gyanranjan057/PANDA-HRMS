generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================================
// EMPLOYEE TABLE
// =====================================

model Employee {
  id           Int     @id @default(autoincrement())
  employeeId   String  @unique
  name         String
  email        String  @unique
  phone        String?
  department   String
  designation  String
  workType     String
  status       String
  role         String
  passwordHash String? @db.VarChar(255)
  leaveBalance Int

  // One Employee -> Many Tasks
  tasks       Task[]
  attendances Attendance[]
  leaves      Leave[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

// =====================================
// PROJECT TABLE
// =====================================

model Project {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(150)
  description String?   @db.Text
  status      String
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date

  // One Project -> Many Tasks
  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

// =====================================
// TASK TABLE
// =====================================

model Task {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(255)
  description String? @db.Text

  priority String
  status   String
  progress Int
  due      String @db.VarChar(50)

  // Project relation
  projectId Int
  project   Project @relation(fields: [projectId], references: [id])

  // Employee assignment
  assignedTo Int?
  employee   Employee? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assignedTo])
  @@index([status])
  @@map("tasks")
}

// =====================================
// ATTENDANCE TABLE
// =====================================

model Attendance {
  id         Int       @id @default(autoincrement())
  employeeId Int
  date       DateTime  @db.Date
  punchIn    DateTime?
  punchOut   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendances")
}

// =====================================
// LEAVE TABLE
// =====================================

model Leave {
  id         Int      @id @default(autoincrement())
  employeeId Int
  leaveType  String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  reason     String?  @db.Text
  status     String

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("leaves")
}
